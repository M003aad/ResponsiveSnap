{
  "manifest_version": 3,
  "name": "ResponsiveSnap",
  "version": "1.0.0",
  "description": "Test responsive designs instantly with a realistic device mockup injected right into the current tab: presets, rotate, custom sizes, URL bar, touch simulation and screenshots.",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/16_16.png",
    "32": "icons/32_32.png",
    "48": "icons/48_48.png",
    "128": "icons/128_128.png"
  },
  "action": {
    "default_title": "ResponsiveSnap \u2013 toggle device preview",
    "default_icon": {
      "16": "icons/16_16.png",
      "32": "icons/32_32.png",
      "48": "icons/48_48.png",
      "128": "icons/128_128.png"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}